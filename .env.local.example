# Vorlage fuer .env.local (gitignored). Werte nach `supabase start` aus `supabase status` uebernehmen.
# Alle Ports sind bewusst 453xx / 3001, damit nichts mit der Boots-Instanz (543xx / 3000) kollidiert.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:45321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:45322/postgres
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001
